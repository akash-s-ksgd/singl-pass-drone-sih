# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Paths
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
OUTPUT_DIR=./data/outputs
MODELS_DIR=./data/models

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/drone3d.db

# Redis (for task queue)
REDIS_URL=redis://localhost:6379/0

# COLMAP (path to COLMAP binary)
COLMAP_PATH=colmap

# GPU
USE_GPU=true
DEVICE=cuda

# Reconstruction defaults
DEFAULT_FPS=2
MIN_SHARPNESS=50.0
MIN_FEATURE_COUNT=100
MAX_FRAMES=500
